# =============================================
# TECHSTORE BACKEND - VARIABLES DE ENTORNO (PRODUCCIÓN)
# =============================================
# NUNCA commits este archivo a Git
# Usa un service como Render, Vercel o Heroku para variables de entorno

# --- SERVIDOR ---
PORT=3000
NODE_ENV=production

# --- MONGODB ATLAS ---
# Reemplaza con tu conexión real de MongoDB Atlas
# Formato: mongodb+srv://<usuario>:<contraseña>@<cluster>.mongodb.net/<base-datos>
MONGODB_URI=mongodb+srv://usuario:contraseña@cluster.mongodb.net/techstore

# --- AUTENTICACIÓN JWT ---
# Usa una cadena de 32+ caracteres alfanuméricos aleatorios
# Puedes generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=tu_clave_secreta_super_segura_minimo_32_caracteres_aleatorios

# --- CORS WHITELIST ---
# Orígenes permitidos separados por comas
ALLOWED_ORIGINS=https://techstore.vercel.app,https://api.techstore.com,https://admin.techstore.com

# ═════════════════════════════════════════════════════════════
# VARIABLES DE ENTORNO - TechStore Backend
# ═════════════════════════════════════════════════════════════
# 
# Copia este archivo a .env y completa con tus valores reales
# NO SUBAS el archivo .env a Git (ya está en .gitignore)
#

# ─────────────────────────────────────────────
# PUERTO Y AMBIENTE
# ─────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─────────────────────────────────────────────
# BASE DE DATOS - MongoDB
# ─────────────────────────────────────────────
# Formato: mongodb://usuario:contraseña@host:puerto/baseDatos
# Para MongoDB Atlas (cloud):
MONGODB_URI=mongodb+srv://usuario:contraseña@cluster.mongodb.net/techstore?retryWrites=true&w=majority

# Para MongoDB local:
# MONGODB_URI=mongodb://localhost:27017/techstore

# ─────────────────────────────────────────────
# JWT (JSON Web Tokens)
# ─────────────────────────────────────────────
# Clave secreta para firmar tokens (debe ser larga y aleatoria)
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=tu_clave_secreta_super_segura_aqui_minimo_32_caracteres

# Tiempo de expiración del token (ej: 7d, 24h, 1w)
JWT_EXPIRE=7d

# ─────────────────────────────────────────────
# SEGURIDAD - CORS
# ─────────────────────────────────────────────
# Orígenes permitidos (separados por coma)
CORS_ORIGINS=http://localhost:4200,http://localhost:3000,https://techstore.vercel.app

# ─────────────────────────────────────────────
# SEGURIDAD - Rate Limiting
# ─────────────────────────────────────────────
# Ventana de tiempo en minutos para rate limiting global
RATE_LIMIT_WINDOW_MS=15
RATE_LIMIT_MAX_REQUESTS=100

# Ventana para login (minutos)
LOGIN_RATE_LIMIT_WINDOW_MS=15
LOGIN_RATE_LIMIT_MAX=5

# ─────────────────────────────────────────────
# OPCIONALES - Logging y Monitoreo
# ─────────────────────────────────────────────
# Nivel de log: error, warn, info, debug
LOG_LEVEL=info

# Habilitar logs de seguridad (intentos de NoSQL injection, etc)
SECURITY_LOGS=true

# ─────────────────────────────────────────────
# OPCIONALES - Integración con servicios externos
# ─────────────────────────────────────────────
# Ej: SendGrid para envío de emails
# SENDGRID_API_KEY=tu_api_key

# Ej: AWS S3 para almacenamiento de archivos
# AWS_ACCESS_KEY_ID=tu_key
# AWS_SECRET_ACCESS_KEY=tu_secret
# AWS_S3_BUCKET=tu_bucket

# ═════════════════════════════════════════════════════════════
# INSTRUCCIONES DE CONFIGURACIÓN
# ═════════════════════════════════════════════════════════════
# 
# 1. Instala las dependencias:
#    npm install
#
# 2. Crea un archivo .env en la raíz del proyecto
#
# 3. Copia este contenido y llena los valores reales:
#    - Obtén la URL de MongoDB (local o Atlas)
#    - Genera una JWT_SECRET segura
#    - Actualiza CORS_ORIGINS según tu dominio
#
# 4. NUNCA SUBAS .env a Git. Está en .gitignore
#
# 5. Para producción (Render, Vercel):
#    - Configura las variables en el panel de la plataforma
#    - Usa valores seguros y diferentes a desarrollo
#
